      {
        "selector": "JSXOpeningElement[name.name='CaseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|subtitle|description|result|resultLabel|note|url|urlLabel|screenshot|variant|style|key|ref|className|style|children)$/]",
